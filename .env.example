# Sao chép file này thành .env.local rồi điền giá trị thật khi bắt đầu nối backend (Tuần 3+).
# Ở bản UI hiện tại (Tuần 1), toàn bộ dữ liệu là mock — chưa cần các biến này để chạy `npm run dev`.

# Supabase (Tuần 3: database + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini (Tuần 2: chatbot QnA). Chỉ dùng phía server, không thêm tiền tố NEXT_PUBLIC_
GEMINI_API_KEY=

# Supabase phía server: lưu hội thoại chatbot (bảng conversations, messages).
# SECRET KEY bỏ qua RLS — chỉ dùng ở server, TUYỆT ĐỐI không thêm tiền tố NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
